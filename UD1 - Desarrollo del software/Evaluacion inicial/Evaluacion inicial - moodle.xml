<question type="multichoice">
  <name><text>B09 - Refactorizar</text></name>
  <questiontext format="html"><text><![CDATA[<p><b>Refactorizar</b> significa:</p>]]></text></questiontext>
  <generalfeedback format="html"><text><![CDATA[<p>La definición de Fowler: cambiar la estructura interna sin alterar el comportamiento externo. Si cambia lo que hace, no es refactorizar.</p>]]></text></generalfeedback>
  <defaultgrade>1</defaultgrade>
  <penalty>0</penalty><single>true</single>
  <shuffleanswers>false</shuffleanswers>
  <answernumbering>none</answernumbering>
  <answer fraction="100" format="html"><text><![CDATA[Cambiar cómo está escrito el código sin cambiar lo que hace]]></text><feedback format="html"><text><![CDATA[Correcto.]]></text></feedback></answer>
  <answer fraction="0" format="html"><text><![CDATA[Añadir funciones nuevas al programa]]></text><feedback format="html"><text><![CDATA[Eso es desarrollar, no refactorizar.]]></text></feedback></answer>
  <answer fraction="0" format="html"><text><![CDATA[Corregir un error que estaba dando fallos]]></text><feedback format="html"><text><![CDATA[Ese es el error más habitual: corregir un fallo NO es refactorizar.]]></text></feedback></answer>
  <answer fraction="0" format="html"><text><![CDATA[No lo sé]]></text><feedback format="html"><text><![CDATA[Es la UD4.]]></text></feedback></answer>
</question>

